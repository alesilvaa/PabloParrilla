---
import { Image } from 'astro:assets';
import pablo from '../assets/pablo-parrilla.jpg';
import { site } from '../config/site';
---
<section class="section gallery" aria-labelledby="gallery-title">
  <div class="container">
    <p class="section-kicker">Pruebas del delito</p>
    <h2 id="gallery-title" class="display section-title">Humo, corte y punto</h2>
    <div class="photos">
      {site.gallery.map((item, i) => (
        <figure>
          <div class={`crop crop-${i + 1}`}><Image src={pablo} alt={`${item.caption}. Foto de Pablo junto a un costillar asado.`} widths={[420, 700]} sizes="(max-width: 760px) 82vw, 31vw" loading="lazy" format="webp" quality={82} /></div>
          <figcaption>{item.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
<style>
  .gallery { background:linear-gradient(145deg,var(--bone),color-mix(in srgb,var(--gold) 12%,var(--bone))); }
  .photos { display:grid; gap:2rem; margin-top:3.5rem; }
  figure { margin:0; padding:.8rem .8rem 1.4rem; background:#fffaf0; box-shadow:0 12px 25px #120d0a2c; transform:rotate(-2deg); }
  figure:nth-child(2){transform:rotate(2.2deg)} figure:nth-child(3){transform:rotate(-1deg)}
  .crop { aspect-ratio:4/3; overflow:hidden; background:#d5c7b4; }
  .crop :global(img){ width:100%; height:100%; object-fit:cover; }
  .crop-1 :global(img){object-position:50% 42%}.crop-2 :global(img){object-position:10% 74%;transform:scale(1.28)}.crop-3 :global(img){object-position:85% 58%;transform:scale(1.25)}
  figcaption { padding-top:.9rem; color:#251a14; text-align:center; font:600 1.55rem Caveat,cursive; }
  @media(min-width:700px){.photos{grid-template-columns:repeat(3,1fr);gap:1.6rem}.photos figure:nth-child(2){margin-top:2rem}}
</style>
