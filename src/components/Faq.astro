---
import { site } from '../config/site';
---
<section class="section faq" aria-labelledby="faq-title"><div class="container"><p class="section-kicker">Antes de prender</p><h2 id="faq-title" class="display section-title">Preguntas frecuentes</h2><div class="faq-list">{site.faq.map(item => <details><summary><span>{item.question}</span><i aria-hidden="true"></i></summary><p>{item.answer}</p></details>)}</div></div></section>
<style>
  .faq-list{margin-top:3rem;border-top:2px solid var(--ink)}details{border-bottom:2px solid var(--ink)}summary{display:flex;justify-content:space-between;align-items:center;gap:1.5rem;padding:1.35rem 0;cursor:pointer;list-style:none;font:1.5rem/1.15 Anton,Impact,sans-serif;text-transform:uppercase}summary::-webkit-details-marker{display:none}summary i{position:relative;width:1.4rem;height:1.4rem;flex:0 0 auto}summary i::before,summary i::after{content:'';position:absolute;left:0;top:50%;width:100%;height:3px;background:var(--fire)}summary i::after{transform:rotate(90deg);transition:.2s}details[open] summary i::after{transform:rotate(0)}details p{max-width:48rem;margin:-.3rem 0 1.4rem;color:var(--muted)}
</style>
