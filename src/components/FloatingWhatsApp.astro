---
import { site } from '../config/site';
const message = encodeURIComponent('Hola, quiero consultar por un asado a domicilio.');
---
<a id="floating-wa" class="floating" href={`https://wa.me/${site.whatsapp}?text=${message}`} target="_blank" rel="noopener noreferrer" aria-label="Consultar por WhatsApp" data-pixel={site.analytics.metaPixelEnabled ? 'on' : 'off'}><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16.04 3A12.9 12.9 0 0 0 5 22.56L3.2 29l6.58-1.73A12.98 12.98 0 1 0 16.04 3Zm0 23.8c-2.06 0-4.08-.56-5.84-1.61l-.42-.25-3.9 1.02 1.04-3.8-.27-.43A10.76 10.76 0 1 1 16.04 26.8Zm5.9-8.06c-.32-.16-1.92-.95-2.22-1.06-.3-.1-.51-.16-.73.16-.22.33-.84 1.06-1.03 1.28-.19.21-.38.24-.7.08-.33-.16-1.38-.5-2.62-1.62-.97-.86-1.62-1.93-1.81-2.26-.19-.32-.02-.5.14-.66.15-.14.33-.38.49-.57.16-.19.21-.32.32-.54.11-.21.06-.4-.03-.56-.08-.16-.73-1.76-1-2.4-.26-.64-.53-.55-.73-.56h-.62c-.22 0-.57.08-.87.4-.3.33-1.14 1.12-1.14 2.72s1.17 3.15 1.33 3.37c.16.22 2.3 3.5 5.56 4.91.78.34 1.38.54 1.86.69.78.24 1.49.21 2.05.13.63-.1 1.92-.79 2.2-1.55.26-.75.26-1.4.18-1.54-.08-.13-.3-.21-.62-.37Z"/></svg></a>
<script>document.querySelector('#floating-wa')?.addEventListener('click', (event) => { const el = event.currentTarget as HTMLElement; if (el.dataset.pixel === 'on' && 'fbq' in window) (window as any).fbq('track', 'Lead'); });</script>
<style>.floating{position:fixed;right:max(.75rem,env(safe-area-inset-right));bottom:max(.75rem,calc(env(safe-area-inset-bottom) + .35rem));z-index:40;width:3.25rem;aspect-ratio:1;display:grid;place-items:center;border:2px solid #120d0a;border-radius:50%;background:#25d366;box-shadow:3px 3px 0 var(--gold);transition:.15s}.floating:hover{transform:translate(-2px,-2px);box-shadow:5px 5px 0 var(--gold)}.floating:active{transform:translate(3px,3px);box-shadow:none}.floating svg{width:1.85rem;fill:#fff}@media(min-width:760px){.floating{right:max(1rem,env(safe-area-inset-right));bottom:max(1rem,calc(env(safe-area-inset-bottom) + .5rem));width:3.8rem;box-shadow:4px 4px 0 var(--gold)}.floating svg{width:2.2rem}}</style>
