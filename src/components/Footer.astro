---
import { site } from '../config/site';
---
<footer><div class="container"><a class="brand" href="#top">{site.businessName}</a><p>Parrillero a domicilio · {site.serviceArea}</p><a href={`https://instagram.com/${site.instagram}`} target="_blank" rel="noopener noreferrer">Instagram ↗</a></div></footer>
<style>footer{padding:3rem 0 calc(3rem + env(safe-area-inset-bottom));background:#120d0a;color:#f1e9dc;border-top:6px solid var(--gold)}footer .container{display:flex;flex-direction:column;gap:.4rem;align-items:flex-start}.brand{font:2rem Anton,sans-serif;text-transform:uppercase;text-decoration:none}p{margin:0;color:#bcaea2}footer a:last-child{color:var(--gold);font-weight:800}@media(min-width:700px){footer .container{display:grid;grid-template-columns:1fr auto;align-items:end}footer p{grid-column:1}footer a:last-child{grid-column:2;grid-row:1/3}}</style>
