---
import { site } from '../config/site';
---
<footer><div class="container"><a class="brand" href="#top">{site.businessName}</a><p>Parrillero a domicilio · {site.serviceArea}</p><a href={`https://instagram.com/${site.instagram}`} target="_blank" rel="noopener noreferrer">Instagram ↗</a></div></footer>
<style>footer{padding:2.25rem 0 calc(2.5rem + env(safe-area-inset-bottom));background:#120d0a;color:#f1e9dc;border-top:5px solid var(--gold)}footer .container{display:flex;flex-direction:column;gap:.35rem;align-items:flex-start}.brand{font:1.7rem Anton,sans-serif;text-transform:uppercase;text-decoration:none}p{margin:0;color:#bcaea2;font-size:.9rem}footer a:last-child{color:var(--gold);font-weight:800}@media(min-width:700px){footer{padding:3rem 0 calc(3rem + env(safe-area-inset-bottom));border-top-width:6px}footer .container{display:grid;grid-template-columns:1fr auto;align-items:end}.brand{font-size:2rem}p{grid-column:1;font-size:1rem}footer a:last-child{grid-column:2;grid-row:1/3}}</style>
